<idea-plugin>
    <id>dev.tendril</id>
    <name>Tendril</name>
    <vendor>tendril</vendor>
    <description><![CDATA[
    <p>Spring Boot tooling for IntelliJ IDEA that works without an Ultimate subscription, in Java and Kotlin.</p>
    <ul>
        <li><b>Configuration</b>: completion in <code>application*.yml</code> and <code>.properties</code>, unknown and
            missing-key inspections, and navigation both ways between a key and the code that reads it, aware of profiles
            and modules.</li>
        <li><b>Beans</b>: gutter icons between injection points and bean definitions, inspections for missing, ambiguous and
            circular beans, a Spring Beans tool window.</li>
        <li><b>Spring Data JPA</b>: completion, navigation and rename for entities, attributes and parameters inside
            <code>@Query</code>, with inspections for unknown entities and attributes and for unbound or unused parameters.</li>
        <li><b>Endpoints</b>: the endpoints your application serves and the Feign clients it calls, with the address each
            client resolves to per profile.</li>
        <li><b>HTTP client</b>: send requests from <code>.http</code> files or straight from an endpoint or Feign call, with
            environment variables and a formatted response.</li>
        <li><b>Running application</b>: an Actuator window (beans, mappings, environment, loggers, conditions) and a recorder
            that captures incoming requests, Feign calls and Rabbit/Kafka listener input for replay. A failed startup report
            links to the bean, key or port it is about, with fixes.</li>
    </ul>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.java</depends>
    <depends>com.intellij.properties</depends>
    <depends>org.jetbrains.plugins.yaml</depends>
    <depends optional="true" config-file="tendril-maven.xml">org.jetbrains.idea.maven</depends>

    <extensions defaultExtensionNs="com.intellij">
        <completion.contributor language="Properties"
                                implementationClass="dev.tendril.config.SpringPropertyCompletionContributor"/>
        <completion.contributor language="yaml"
                                implementationClass="dev.tendril.config.SpringYamlCompletionContributor"/>
        <localInspection language="Properties" groupName="Tendril" enabledByDefault="true"
                         level="WEAK WARNING" shortName="TendrilUnknownPropertiesKey"
                         displayName="Unknown Spring Boot property"
                         implementationClass="dev.tendril.config.UnknownPropertiesKeyInspection"/>
        <localInspection language="yaml" groupName="Tendril" enabledByDefault="true"
                         level="WEAK WARNING" shortName="TendrilUnknownYamlKey"
                         displayName="Unknown Spring Boot property"
                         implementationClass="dev.tendril.config.UnknownYamlKeyInspection"/>
        <completion.contributor language="kotlin"
                                implementationClass="dev.tendril.config.ValuePlaceholderCompletionContributor"/>
        <completion.contributor language="JAVA"
                                implementationClass="dev.tendril.config.ValuePlaceholderCompletionContributor"/>
        <localInspection language="UAST" groupName="Tendril" enabledByDefault="true"
                         level="WEAK WARNING" shortName="TendrilUnresolvedValueKey"
                         displayName="Unresolved configuration key in @Value"
                         implementationClass="dev.tendril.config.UnresolvedValueKeyInspection"/>
        <localInspection language="UAST" groupName="Tendril" enabledByDefault="true"
                         level="WARNING" shortName="TendrilMissingRequiredProperty"
                         displayName="Required configuration property is not defined"
                         implementationClass="dev.tendril.config.MissingRequiredPropertyInspection"/>
        <codeInsight.lineMarkerProvider language="kotlin"
                                        implementationClass="dev.tendril.beans.BeanLineMarkerProvider"/>
        <codeInsight.lineMarkerProvider language="JAVA"
                                        implementationClass="dev.tendril.beans.BeanLineMarkerProvider"/>
        <codeInsight.lineMarkerProvider language="kotlin"
                                        implementationClass="dev.tendril.config.CodeToConfigLineMarkerProvider"/>
        <codeInsight.lineMarkerProvider language="JAVA"
                                        implementationClass="dev.tendril.config.CodeToConfigLineMarkerProvider"/>
        <codeInsight.lineMarkerProvider language="yaml"
                                        implementationClass="dev.tendril.config.ConfigKeyLineMarkerProvider"/>
        <codeInsight.lineMarkerProvider language="Properties"
                                        implementationClass="dev.tendril.config.ConfigKeyLineMarkerProvider"/>
        <psi.referenceContributor language="UAST"
                                  implementation="dev.tendril.resources.SqlResourceReferenceContributor"/>
        <codeInsight.lineMarkerProvider implementationClass="dev.tendril.resources.SqlUsagesLineMarkerProvider"/>
        <gotoDeclarationHandler implementation="dev.tendril.config.ConfigKeyGotoDeclarationHandler"/>
        <psi.referenceContributor language="UAST"
                                  implementation="dev.tendril.config.ValuePlaceholderReferenceContributor"/>
        <codeInsight.lineMarkerProvider language="kotlin"
                                        implementationClass="dev.tendril.beans.BeanUsagesLineMarkerProvider"/>
        <codeInsight.lineMarkerProvider language="JAVA"
                                        implementationClass="dev.tendril.beans.BeanUsagesLineMarkerProvider"/>
        <localInspection language="UAST" groupName="Tendril" enabledByDefault="true" level="WEAK WARNING"
                         shortName="TendrilFieldInjection" displayName="Field injection"
                         implementationClass="dev.tendril.beans.FieldInjectionInspection"/>
        <localInspection language="UAST" groupName="Tendril" enabledByDefault="true" level="WEAK WARNING"
                         shortName="TendrilNoBeanFound" displayName="No bean of the injected type"
                         implementationClass="dev.tendril.beans.NoBeanFoundInspection"/>
        <localInspection language="UAST" groupName="Tendril" enabledByDefault="true" level="WARNING"
                         shortName="TendrilAmbiguousBean" displayName="Multiple beans of the injected type"
                         implementationClass="dev.tendril.beans.AmbiguousBeanInspection"/>
        <localInspection language="UAST" groupName="Tendril" enabledByDefault="true" level="WARNING"
                         shortName="TendrilCircularDependency" displayName="Circular bean dependency"
                         implementationClass="dev.tendril.beans.CircularDependencyInspection"/>
        <searchEverywhereContributor implementation="dev.tendril.endpoints.EndpointSearchContributorFactory"/>
        <fileType name="Tendril HTTP" implementationClass="dev.tendril.http.HttpFileType" fieldName="INSTANCE"
                  language="TendrilHttp" extensions="http;rest"/>
        <lang.parserDefinition language="TendrilHttp" implementationClass="dev.tendril.http.HttpParserDefinition"/>
        <lang.syntaxHighlighterFactory language="TendrilHttp"
                                       implementationClass="dev.tendril.http.HttpSyntaxHighlighterFactory"/>
        <codeInsight.lineMarkerProvider language="TendrilHttp"
                                        implementationClass="dev.tendril.http.HttpLineMarkerProvider"/>
        <postStartupActivity implementation="dev.tendril.recordings.RecordingsStartup"/>
        <toolWindow id="Recordings" anchor="bottom" icon="/icons/recordings.svg"
                    factoryClass="dev.tendril.recordings.RecordingsToolWindowFactory"/>
        <projectConfigurable parentId="tools" instance="dev.tendril.settings.TendrilConfigurable"
                             id="dev.tendril.settings" displayName="Tendril" nonDefaultProject="true"/>
        <notificationGroup id="Tendril" displayType="BALLOON"/>
        <!-- Spring Beans tool window: switched off for now (dev.tendril.beans.BeansToolWindowFactory) -->
        <toolWindow id="Spring Endpoints" anchor="right" icon="/icons/endpoints.svg"
                    factoryClass="dev.tendril.endpoints.EndpointsToolWindowFactory"/>
        <codeInsight.lineMarkerProvider language="kotlin"
                                        implementationClass="dev.tendril.feign.FeignLineMarkerProvider"/>
        <codeInsight.lineMarkerProvider language="JAVA"
                                        implementationClass="dev.tendril.feign.FeignLineMarkerProvider"/>
        <toolWindow id="HTTP Response" anchor="bottom" icon="/icons/httpResponse.svg"
                    factoryClass="dev.tendril.http.HttpResponseToolWindowFactory"/>
        <toolWindow id="Spring Actuator" anchor="right" icon="/icons/actuator.svg"
                    factoryClass="dev.tendril.actuator.ActuatorToolWindowFactory"/>
        <toolWindow id="Batch Jobs" anchor="right" icon="/icons/batchJobs.svg"
                    factoryClass="dev.tendril.batch.BatchJobsToolWindowFactory"/>

        <!-- "APPLICATION FAILED TO START" in the Run console: links to the bean, key, file or port, with fixes -->
        <consoleFilterProvider implementation="dev.tendril.startup.StartupFailureFilterProvider"/>
        <!-- logger column of Spring Boot console lines: go to the class, change its level -->
        <consoleFilterProvider implementation="dev.tendril.logs.LoggerFilterProvider"/>

        <runConfigurationExtension implementation="dev.tendril.recordings.run.RecorderRunConfigurationExtension"/>

        <!-- inline text after Spring annotations: resolved @Value, Feign address, next @Scheduled run, @Transactional summary -->
        <codeInsight.declarativeInlayProvider language="JAVA" isEnabledByDefault="true" group="OTHER_GROUP"
                                              providerId="tendril.value" bundle="messages.TendrilBundle" nameKey="hints.value.name"
                                              implementationClass="dev.tendril.hints.ValueHints"/>
        <codeInsight.declarativeInlayProvider language="kotlin" isEnabledByDefault="true" group="OTHER_GROUP"
                                              providerId="tendril.value" bundle="messages.TendrilBundle" nameKey="hints.value.name"
                                              implementationClass="dev.tendril.hints.ValueHints"/>
        <codeInsight.declarativeInlayProvider language="JAVA" isEnabledByDefault="true" group="OTHER_GROUP"
                                              providerId="tendril.feign" bundle="messages.TendrilBundle" nameKey="hints.feign.name"
                                              implementationClass="dev.tendril.hints.FeignHints"/>
        <codeInsight.declarativeInlayProvider language="kotlin" isEnabledByDefault="true" group="OTHER_GROUP"
                                              providerId="tendril.feign" bundle="messages.TendrilBundle" nameKey="hints.feign.name"
                                              implementationClass="dev.tendril.hints.FeignHints"/>
        <codeInsight.declarativeInlayProvider language="JAVA" isEnabledByDefault="true" group="OTHER_GROUP"
                                              providerId="tendril.scheduled" bundle="messages.TendrilBundle" nameKey="hints.scheduled.name"
                                              implementationClass="dev.tendril.hints.ScheduledHints"/>
        <codeInsight.declarativeInlayProvider language="kotlin" isEnabledByDefault="true" group="OTHER_GROUP"
                                              providerId="tendril.scheduled" bundle="messages.TendrilBundle" nameKey="hints.scheduled.name"
                                              implementationClass="dev.tendril.hints.ScheduledHints"/>
        <codeInsight.declarativeInlayProvider language="JAVA" isEnabledByDefault="true" group="OTHER_GROUP"
                                              providerId="tendril.transactional" bundle="messages.TendrilBundle" nameKey="hints.transactional.name"
                                              implementationClass="dev.tendril.hints.TransactionalHints"/>
        <codeInsight.declarativeInlayProvider language="kotlin" isEnabledByDefault="true" group="OTHER_GROUP"
                                              providerId="tendril.transactional" bundle="messages.TendrilBundle" nameKey="hints.transactional.name"
                                              implementationClass="dev.tendril.hints.TransactionalHints"/>

        <!-- Spring Data JPA: entities, attributes and parameters inside @Query -->
        <psi.referenceContributor language="UAST" implementation="dev.tendril.jpa.QueryReferenceContributor"/>
        <referencesSearch implementation="dev.tendril.jpa.QueryReferenceSearcher"/>
        <completion.contributor language="JAVA" implementationClass="dev.tendril.jpa.QueryCompletionContributor"/>
        <completion.contributor language="kotlin" implementationClass="dev.tendril.jpa.QueryCompletionContributor"/>
        <localInspection language="UAST" groupName="Tendril" enabledByDefault="true" level="WARNING"
                         shortName="TendrilJpqlQuery" displayName="Unknown entity or attribute in @Query"
                         implementationClass="dev.tendril.jpa.JpqlQueryInspection"/>
        <localInspection language="UAST" groupName="Tendril" enabledByDefault="true" level="WARNING"
                         shortName="TendrilQueryParameters" displayName="@Query parameter that is not bound or not used"
                         implementationClass="dev.tendril.jpa.QueryParameterInspection"/>

        <!-- service calls across linked projects: React fetch -> BFF endpoint -> Feign -> backend endpoint -->
        <postStartupActivity implementation="dev.tendril.calls.ServiceMapStartup"/>

        <localInspection language="UAST" groupName="Tendril" enabledByDefault="true" level="WARNING"
                         shortName="TendrilTransactionalPitfalls" displayName="@Transactional that Spring will not apply"
                         implementationClass="dev.tendril.transactions.TransactionalPitfallsInspection"/>
    </extensions>

    <actions>
        <action id="Tendril.SendHttpRequest" class="dev.tendril.http.SendHttpRequestAction"
                text="Send HTTP Request" description="Send the request under the caret in a .http file">
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl ENTER"/>
            <add-to-group group-id="EditorPopupMenu" anchor="first"/>
        </action>
        <action id="Tendril.FindServiceCalls" class="dev.tendril.calls.FindServiceCallsAction"
                text="Find Service Calls" description="Who calls this endpoint or Feign method across the linked projects, and what it calls">
            <add-to-group group-id="EditorPopupMenu" anchor="after" relative-to-action="Tendril.SendHttpRequest"/>
        </action>
        <action id="Tendril.CreateFeignClient" class="dev.tendril.calls.clientgen.CreateFeignClientAction"
                text="Create Feign Client Method…" description="Write the Feign method that calls this endpoint, with its request and response classes, into an open project (the BFF)">
            <add-to-group group-id="EditorPopupMenu" anchor="after" relative-to-action="Tendril.FindServiceCalls"/>
        </action>
        <action id="Tendril.MockResponse" class="dev.tendril.mocks.MockResponseAction"
                text="Mock Response" description="Answer this Feign method or endpoint with a mocked response while the application runs with the recorder">
            <add-to-group group-id="EditorPopupMenu" anchor="after" relative-to-action="Tendril.FindServiceCalls"/>
        </action>
        <action id="Tendril.SendTestMessage" class="dev.tendril.messaging.SendTestMessageAction"
                text="Send Test Message" description="Send a message to this listener's topic or queue through the running application">
            <add-to-group group-id="EditorPopupMenu" anchor="after" relative-to-action="Tendril.MockResponse"/>
        </action>
    </actions>
</idea-plugin>
