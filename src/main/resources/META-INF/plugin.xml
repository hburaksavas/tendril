<idea-plugin>
    <id>dev.tendril</id>
    <name>Tendril</name>
    <vendor>tendril</vendor>
    <description><![CDATA[
    Spring Boot tooling without an Ultimate subscription: property and value completion,
    unknown-property inspection, endpoint explorer and bean navigation gutter icons.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.java</depends>
    <depends>com.intellij.properties</depends>
    <depends>org.jetbrains.plugins.yaml</depends>
    <depends optional="true" config-file="tendril-maven.xml">org.jetbrains.idea.maven</depends>

    <extensions defaultExtensionNs="com.intellij">
        <completion.contributor language="Properties"
                                implementationClass="dev.tendril.config.SpringPropertyCompletionContributor"/>
        <completion.contributor language="yaml"
                                implementationClass="dev.tendril.config.SpringYamlCompletionContributor"/>
        <localInspection language="Properties" groupName="Tendril" enabledByDefault="true"
                         level="WEAK WARNING" shortName="TendrilUnknownPropertiesKey"
                         displayName="Unknown Spring Boot property"
                         implementationClass="dev.tendril.config.UnknownPropertiesKeyInspection"/>
        <localInspection language="yaml" groupName="Tendril" enabledByDefault="true"
                         level="WEAK WARNING" shortName="TendrilUnknownYamlKey"
                         displayName="Unknown Spring Boot property"
                         implementationClass="dev.tendril.config.UnknownYamlKeyInspection"/>
        <completion.contributor language="JAVA"
                                implementationClass="dev.tendril.config.ValuePlaceholderCompletionContributor"/>
        <localInspection language="JAVA" groupName="Tendril" enabledByDefault="true"
                         level="WEAK WARNING" shortName="TendrilUnresolvedValueKey"
                         displayName="Unresolved configuration key in @Value"
                         implementationClass="dev.tendril.config.UnresolvedValueKeyInspection"/>
        <localInspection language="JAVA" groupName="Tendril" enabledByDefault="true"
                         level="WARNING" shortName="TendrilMissingRequiredProperty"
                         displayName="Required configuration property is not defined"
                         implementationClass="dev.tendril.config.MissingRequiredPropertyInspection"/>
        <codeInsight.lineMarkerProvider language="JAVA"
                                        implementationClass="dev.tendril.beans.BeanLineMarkerProvider"/>
        <codeInsight.lineMarkerProvider language="JAVA"
                                        implementationClass="dev.tendril.config.CodeToConfigLineMarkerProvider"/>
        <codeInsight.lineMarkerProvider language="yaml"
                                        implementationClass="dev.tendril.config.ConfigKeyLineMarkerProvider"/>
        <codeInsight.lineMarkerProvider language="Properties"
                                        implementationClass="dev.tendril.config.ConfigKeyLineMarkerProvider"/>
        <gotoDeclarationHandler implementation="dev.tendril.config.ConfigKeyGotoDeclarationHandler"/>
        <psi.referenceContributor language="JAVA"
                                  implementation="dev.tendril.config.ValuePlaceholderReferenceContributor"/>
        <codeInsight.lineMarkerProvider language="JAVA"
                                        implementationClass="dev.tendril.beans.BeanUsagesLineMarkerProvider"/>
        <localInspection language="JAVA" groupName="Tendril" enabledByDefault="true" level="WEAK WARNING"
                         shortName="TendrilFieldInjection" displayName="Field injection"
                         implementationClass="dev.tendril.beans.FieldInjectionInspection"/>
        <localInspection language="JAVA" groupName="Tendril" enabledByDefault="true" level="WEAK WARNING"
                         shortName="TendrilNoBeanFound" displayName="No bean of the injected type"
                         implementationClass="dev.tendril.beans.NoBeanFoundInspection"/>
        <localInspection language="JAVA" groupName="Tendril" enabledByDefault="true" level="WARNING"
                         shortName="TendrilAmbiguousBean" displayName="Multiple beans of the injected type"
                         implementationClass="dev.tendril.beans.AmbiguousBeanInspection"/>
        <localInspection language="JAVA" groupName="Tendril" enabledByDefault="true" level="WARNING"
                         shortName="TendrilCircularDependency" displayName="Circular bean dependency"
                         implementationClass="dev.tendril.beans.CircularDependencyInspection"/>
        <searchEverywhereContributor implementation="dev.tendril.endpoints.EndpointSearchContributorFactory"/>
        <fileType name="Tendril HTTP" implementationClass="dev.tendril.http.HttpFileType" fieldName="INSTANCE"
                  language="TendrilHttp" extensions="http;rest"/>
        <lang.parserDefinition language="TendrilHttp" implementationClass="dev.tendril.http.HttpParserDefinition"/>
        <lang.syntaxHighlighterFactory language="TendrilHttp"
                                       implementationClass="dev.tendril.http.HttpSyntaxHighlighterFactory"/>
        <codeInsight.lineMarkerProvider language="TendrilHttp"
                                        implementationClass="dev.tendril.http.HttpLineMarkerProvider"/>
        <postStartupActivity implementation="dev.tendril.recordings.RecordingsStartup"/>
        <toolWindow id="Recordings" anchor="bottom" icon="/icons/recordings.svg"
                    factoryClass="dev.tendril.recordings.RecordingsToolWindowFactory"/>
        <notificationGroup id="Tendril" displayType="BALLOON"/>
        <toolWindow id="Spring Beans" anchor="right" icon="/icons/beans.svg"
                    factoryClass="dev.tendril.beans.BeansToolWindowFactory"/>
        <toolWindow id="Spring Endpoints" anchor="right" icon="/icons/endpoints.svg"
                    factoryClass="dev.tendril.endpoints.EndpointsToolWindowFactory"/>
        <codeInsight.lineMarkerProvider language="JAVA"
                                        implementationClass="dev.tendril.feign.FeignLineMarkerProvider"/>
        <toolWindow id="Spring Actuator" anchor="right" icon="/icons/actuator.svg"
                    factoryClass="dev.tendril.actuator.ActuatorToolWindowFactory"/>
    </extensions>

    <actions>
        <action id="Tendril.SendHttpRequest" class="dev.tendril.http.SendHttpRequestAction"
                text="Send HTTP Request" description="Send the request under the caret in a .http file">
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl ENTER"/>
            <add-to-group group-id="EditorPopupMenu" anchor="first"/>
        </action>
    </actions>
</idea-plugin>
